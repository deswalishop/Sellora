# Copy to .env.local and fill in (never commit real keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Used by middleware to detect store subdomains. For local dev use "localhost:3000"
# and test stores via lvh.me (resolves to 127.0.0.1): e.g. demo.lvh.me:3000
NEXT_PUBLIC_ROOT_DOMAIN=sellora.com
